      <column caption='YTD Total_Sales' datatype='integer' default-format='c&quot;$&quot;#,##0,,.00M' name='[Calculation_1903592115310592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF &#13;&#10;YEAR([Date]) = {MAX(YEAR([Date]))}&#13;&#10;THEN &#13;&#10;[Price ($)]&#13;&#10;END)' />
      </column>
      <column caption='YOY Sales Growth' datatype='real' name='[Calculation_1903592117796866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1903592115310592]/[YTD Total_Sales (copy)_1903592117542913]-1' />
      </column>
      <column caption='YTD Cars Sold' datatype='integer' name='[Calculation_1903592121257987]' role='measure' type='quantitative'>
